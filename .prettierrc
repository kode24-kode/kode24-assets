{
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "printWidth": 120,
        "tabWidth": 2,
        "useTabs": false,
        "semi": false,
        "singleQuote": false,
        "trailingComma": "none",
        "bracketSpacing": false,
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ],
  "ignore": [
    "*.html"
  ]
}