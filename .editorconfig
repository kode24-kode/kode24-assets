root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

[*.html]
indent_style = space
indent_size = 2
# Completely disable auto formatting for HTML files
format_on_save = false
format_on_paste = false
format_on_type = false
